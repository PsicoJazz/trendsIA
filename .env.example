# Copie este arquivo para .env e preencha. NUNCA versione o .env.
# URL base de uma API compativel com OpenAI (o codigo acrescenta /chat/completions).
# Confirme o caminho exato (ex.: /v1) na plataforma.
LLM_BASE_URL=
LLM_MODEL=
# Opcional: so preencha se o servico exigir chave. Nunca coloque a chave real em arquivos versionados.
LLM_API_KEY=
LLM_TIMEOUT=120
# Opcional: certificado TLS. Use LLM_CA_BUNDLE (caminho de um arquivo .pem) se o servico usa certificado proprio.
# LLM_VERIFY_SSL=false desativa a verificacao: use SOMENTE dentro da rede interna da plataforma.
LLM_CA_BUNDLE=
LLM_VERIFY_SSL=true
